# Copy this file to .env and set the dataset archive you received from the group.
# Absolute paths are safest; repository-relative paths also work.
INAT_DATA_ARCHIVE=/absolute/path/to/selected_images.tar.gz

# These are portable defaults and may be left unchanged. Relative paths are
# resolved from the repository root.
INAT_DATA_DIR=data/inat500
INAT_METADATA_DIR=metadata
INAT_CHECKPOINT_DIR=checkpoints
INAT_RESULTS_DIR=results
INAT_CACHE_DIR=cache
